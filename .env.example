# 複製成 .env 使用（cp .env.example .env）。.env 不進版控。
# server 與 worker 啟動時會自動讀取；server 與所有 worker 要用「同一組」token。
# 產生一組：  head -c16 /dev/urandom | base64
REVSWARM_TOKEN=change-me-to-a-shared-secret

# google_worker.py 不需要任何金鑰（它用 Playwright 開系統 Chrome 查 Google 搜尋；
# Custom Search JSON API 已對新客戶關閉，見 README）。只要同一組 REVSWARM_TOKEN。

# gemini_worker.py / mops/gemini_benchmark.py（實驗性，engine=gemini 佇列）用的 GCP 專案。
# 走 Vertex AI（Agent Platform），認證用 ADC 不是 API key ——【沒有金鑰要放進這個檔】：
#     gcloud auth application-default login
#     gcloud services enable aiplatform.googleapis.com
# ⚠️ 這會花錢，額度算在這個專案的 Google Cloud 帳單上，且 Vertex 沒有免費 grounding 額度。
# ⚠️ AI Studio 那道門（GEMINI_API_KEY / x-goog-api-key）已刻意移除，別加回來
#    —— Cloud 額度付不了它的帳，且實測一律 429，見 README「怎麼走到 Vertex 這條路的」。
# 只跑 server / yahoo_worker / google_worker 的機器不需要這行。
#GOOGLE_CLOUD_PROJECT=your-project-id
