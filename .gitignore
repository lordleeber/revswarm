__pycache__/
*.pyc

# 虛擬環境（本機用，可由 python3 -m venv .venv 重建）
.venv/
venv/

# 秘密：token 放這，別進版控
.env

# 執行期產物（可由 build/init 重建，不進版控）
revswarm.db
revswarm.db-wal
revswarm.db-shm
*.db
*.db-wal
*.db-shm
revenue_dates.csv
missing.csv
all.csv

# MOPS 交叉驗證產物（可由 mops_validate.py 重建）
mops_baseline.csv
mops_baseline.csv.done
mops_validation.csv

# Gemini grounding 對照實驗的逐筆結果（可由 gemini_benchmark.py 重跑，但重跑要再付費，
# 所以想留就自己備份到別處；不進版控是因為它會隨模型版本變動、不是穩定基準）
gemini_benchmark.csv

# DB 備份快照（mops_fill.py / mops_overwrite.py 執行前自動備份，勿進版控）
# *.bak 是手動備份（如蓋 verified 前的 revswarm.db.bak）；⚠️ 別用 cp 備 WAL 模式的 DB，
# 那只會複製主檔、漏掉 -wal 裡還沒 checkpoint 的東西。用 sqlite3 的 backup API：
#   python3 -c "import sqlite3;s=sqlite3.connect('file:revswarm.db?mode=ro',uri=True);\
#     d=sqlite3.connect('revswarm.db.bak');s.backup(d)"
*.bak-*
*.bak

# 來源/衍生資料暫存區（官方 TWSE/TPEx 下載檔、build 產物，可重抓/重建，不進版控）
tmp/

# Goodinfo 爬取的第三方原始頁（受其 ToS 保護，勿進版控/散布）
# 只擋原始頁；goodinfo/ 底下的程式碼要進版控
goodinfo/basicInfo/
